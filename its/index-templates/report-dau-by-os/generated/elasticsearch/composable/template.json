{
  "_meta": {
    "description": "Sample composable template that includes all ECS fields",
    "ecs_version": "8.9.0"
  },
  "composed_of": [
    "ecs_8.9.0_base",
    "ecs_8.9.0_its_report_dau_by_os"
  ],
  "index_patterns": [
    "report_*_*_dau_by_os",
    "report_*_*_mau_by_os"
  ],
  "priority": 1,
  "template": {
    "mappings": {
      "dynamic": false
    },
    "settings": {
      "index": {
        "auto_expand_replicas": "false",
        "codec": "best_compression",
        "mapping": {
          "total_fields": {
            "limit": 2000
          }
        },
        "number_of_replicas": 0
      }
    }
  }
}
