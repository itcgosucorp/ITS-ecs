{
  "index_patterns": [
    "report_*_*_login_period",
    "test_report_*_*_login_period"
  ],
  "mappings": {
    "dynamic": false,
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "first_login_at": {
        "type": "date"
      },
      "labels": {
        "properties": {
          "app": {
            "properties": {
              "keyword": {
                "ignore_above": 1024,
                "type": "keyword"
              }
            }
          },
          "publisher": {
            "properties": {
              "keyword": {
                "ignore_above": 1024,
                "type": "keyword"
              }
            }
          }
        }
      },
      "last_login_at": {
        "type": "date"
      },
      "user": {
        "properties": {
          "name": {
            "ignore_above": 1024,
            "type": "keyword"
          }
        }
      }
    }
  },
  "order": 1,
  "settings": {
    "index": {
      "auto_expand_replicas": "false",
      "codec": "best_compression",
      "mapping": {
        "total_fields": {
          "limit": 1000
        }
      },
      "number_of_replicas": 0,
      "refresh_interval": "2s"
    }
  }
}
