{
  "index_patterns": [
    "report_*_*_mau",
    "test_report_*_*_mau"
  ],
  "mappings": {
    "dynamic": false,
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "count": {
        "type": "long"
      },
      "labels": {
        "properties": {
          "app": {
            "properties": {
              "keyword": {
                "ignore_above": 1024,
                "type": "keyword"
              }
            }
          },
          "publisher": {
            "properties": {
              "keyword": {
                "ignore_above": 1024,
                "type": "keyword"
              }
            }
          }
        }
      }
    }
  },
  "order": 1,
  "settings": {
    "index": {
      "codec": "best_compression",
      "mapping": {
        "total_fields": {
          "limit": 1000
        }
      },
      "refresh_interval": "2s"
    }
  }
}
