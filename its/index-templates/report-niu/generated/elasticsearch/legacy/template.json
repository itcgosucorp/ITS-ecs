{
  "index_patterns": [
    "report_*_*_niu",
    "test_report_*_*_niu"
  ],
  "mappings": {
    "dynamic": false,
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "count": {
        "type": "long"
      },
      "os": {
        "ignore_above": 1024,
        "type": "keyword"
      }
    }
  },
  "order": 1,
  "settings": {
    "index": {
      "auto_expand_replicas": "false",
      "codec": "best_compression",
      "mapping": {
        "total_fields": {
          "limit": 1000
        }
      },
      "number_of_replicas": 0,
      "refresh_interval": "2s"
    }
  }
}
